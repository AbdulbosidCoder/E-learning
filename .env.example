# Copy to .env and fill in.

# Claude API key used to turn documents into courses
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Only emails on this domain can be added / log in (leave empty to allow any)
COMPANY_EMAIL_DOMAIN=company.uz

# First admin account, created on first start when the database is empty
ADMIN_EMAIL=admin@company.uz
ADMIN_PASSWORD=admin12345

# Port the web app is served on
WEB_PORT=8080
